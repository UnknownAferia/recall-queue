DISCORD_TOKEN=your_vora_core_bot_token
DISCORD_CLIENT_ID=your_vora_core_application_id
DISCORD_GUILD_IDS=first_guild_id,second_guild_id

VORA_COMMUNITY_DISCORD_TOKEN=your_vora_community_bot_token
VORA_COMMUNITY_DISCORD_CLIENT_ID=your_vora_community_application_id

# Private read-only Vora Control dashboard
VORA_CONTROL_USERNAME=operations
VORA_CONTROL_PASSWORD_HASH='$2a$14$replace_with_a_caddy_bcrypt_hash'
VORA_CONTROL_DISCORD_CLIENT_SECRET=your_vora_community_oauth_client_secret
VORA_CONTROL_DISCORD_GUILD_ID=your_production_discord_guild_id
# Optional comma-separated Core and Operations role IDs. Guild owner and
# Administrator permission are always accepted.
VORA_CONTROL_ALLOWED_ROLE_IDS=
VORA_CONTROL_DISCORD_REDIRECT_URI=https://voramlbb.com/control/auth/callback
VORA_CONTROL_SESSION_SECRET=replace_with_at_least_32_random_characters

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DATABASE=vora

VORA_TEST_MODE=false

# Optional operational settings
VORA_HEALTHCHECK_MAX_AGE_MS=90000
VORA_BACKUP_DIRECTORY=backups
VORA_BACKUP_MAX_AGE_MS=86400000
VORA_BACKUP_RETENTION_DAYS=14
VORA_RESTORE_DRILL_DATABASE=vora_restore_drill
